{
  "name": "@agent-web/core",
  "version": "0.2.0",
  "description": "Language-neutral Agent Web contracts with a TypeScript implementation",
  "type": "module",
  "exports": {
    ".": "./typescript/src/index.ts"
  },
  "files": [
    "python/src/libagentweb/schemas/agent-web-resource.schema.json",
    "python/src/libagentweb/schemas/agent-web-context.jsonld",
    "typescript/src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test typescript/tests/*.test.ts",
    "validate": "tsx typescript/scripts/validate-url.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0"
}
